# Copy this file to .env and fill in the two Elasticsearch variables to turn
# search on. .env is gitignored; never commit real credentials.
#
# With neither set, search runs on Postgres full-text search instead — the
# app works fine without this file.

# Elasticsearch Serverless
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# Optional — see README.md for defaults and what each one does.
AIBRAIN_ES_INFERENCE_ID=
AIBRAIN_ES_INDEX_PREFIX=
AIBRAIN_ES_BATCH=
AIBRAIN_ES_POLL_MS=
