# Copy to .env and fill in. `.env` is gitignored: never commit real credentials.
# aibrain-core loads the nearest .env on startup; real environment variables win.

# Postgres. The default matches docker-compose.yml.
# AIBRAIN_DATABASE_URL=postgres://aibrain:aibrain@127.0.0.1:5433/aibrain

# Elasticsearch. Leave both blank to keep search on Postgres.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# Optional Elasticsearch tuning.
# AIBRAIN_ES_INFERENCE_ID=.jina-embeddings-v5-omni-small
# AIBRAIN_ES_INDEX_PREFIX=aibrain-
